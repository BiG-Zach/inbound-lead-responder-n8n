# =============================================================================
# Inbound Lead Responder — environment variables
# =============================================================================
#
# Two ways to set these in n8n:
#
#   1. n8n UI: Settings → Variables. Add each key/value there. This is the
#      easiest path for n8n Cloud or anyone who doesn't manage their own host.
#
#   2. Host environment: export these in your shell, docker-compose file,
#      systemd unit, or .env file alongside your n8n install. The workflow
#      reads them via {{ $env.VAR_NAME }} expressions.
#
# Copy this file to .env and fill in the values. Do NOT commit the real .env.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# OpenRouter API key — powers both the classifier and the reply drafter.
# Sign up free at https://openrouter.ai/  → Keys → Create Key.
# Set this as the value of the "OpenRouter API" credential in n8n
# (Credentials → New → HTTP Header Auth, header "Authorization",
# value "Bearer <this key>"). You do NOT have to expose it as an env var
# if you only use it via the n8n credential store.
OPENROUTER_API_KEY=sk-or-v1-replace-me


# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Slack incoming webhook URL — fired for hot_lead and partnership classifications.
# Create one at https://api.slack.com/messaging/webhooks
# Leave unset to skip Slack notifications (the node has continueOnFail enabled,
# so the workflow still succeeds without it).
SLACK_WEBHOOK_URL=

# Gmail "from" address — the address replies are sent from.
# Used as documentation only; the actual Gmail account is selected by the
# Gmail OAuth2 credential you authorize on the "Send Email Reply" node.
GMAIL_FROM_EMAIL=you@yourdomain.com
